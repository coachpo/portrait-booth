      "id": "china-embassy-ma-visa-photo",
      "url": "https://ma.china-embassy.gov.cn/lsfw/lszj/fhqz/cjwd/202504/t20250427_11605605.htm",
      "title": "China visa photo specifications (FAQ)",
      "authority": "Embassy of the People's Republic of China in the Kingdom of Morocco",
      "sourceUpdatedAt": "2025-04-27",
      "accessedAt": "2026-08-05"
    }
  ],
  "output": {
    "kind": "exact_pixels",
    "widthPx": 354,
    "heightPx": 472,
    "aspect": {
      "width": 3,
      "height": 4,
      "enforcement": "mandatory",
      "provenance": "derived"
    }
  },
  "outputFile": {
    "mime": ["image/jpeg"],
    "colorSpace": "sRGB",
    "bitsPerChannel": 8,
    "channels": 3
  },
  "cropRules": [
    {
      "id": "cn-visa-ma-face-width",
      "metric": "face_width",
      "min": 191,
      "max": 219,
      "unit": "px",
      "anchors": ["face_left", "face_right"],
      "axis": "x",
      "bounds": "inclusive",
      "coordinateSpace": "output_pixel_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "face width 191-219 px (354×472 size only)"
    },
    {
      "id": "cn-visa-ma-head-top-margin",
      "metric": "head_top_margin",
      "min": 10,
      "max": 70,
      "unit": "px",
      "anchors": ["hairline"],
      "axis": "y",
      "bounds": "inclusive",
      "coordinateSpace": "output_pixel_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "hairline to top edge 10-70 px"
    },
    {
      "id": "cn-visa-ma-eye-line-from-bottom",
      "metric": "eye_line_from_bottom",
      "min": 256,
      "unit": "px",
      "anchors": ["eye_line"],
      "axis": "y",
      "bounds": "inclusive",
      "coordinateSpace": "output_pixel_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "eye line at least 256 px from the bottom"
    },
    {
      "id": "cn-visa-ma-interpupil-distance",
      "metric": "interpupil_distance",
      "min": 60,
      "unit": "px",
      "anchors": ["left_pupil", "right_pupil"],
      "axis": "x",
      "bounds": "inclusive",
      "coordinateSpace": "output_pixel_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "interpupillary distance greater than 60 px"
    },
    {
      "id": "cn-visa-ma-yaw",
      "metric": "yaw",
      "target": 0,
      "unit": "degree",
      "anchors": ["face"],
      "axis": "angle",
      "bounds": "inclusive",
      "coordinateSpace": "pose_camera_degrees",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "front-facing target 0°; the source's maximum yaw of 20° is an upper bound, not a target"
    },
    {
      "id": "cn-visa-ma-pitch",
      "metric": "pitch",
      "target": 0,
      "unit": "degree",
      "anchors": ["face"],
      "axis": "angle",
      "bounds": "inclusive",
      "coordinateSpace": "pose_camera_degrees",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "front-facing target 0°; the source's maximum pitch of 25° is an upper bound, not a target"
    }
  ],
  "captureRules": [
    {
      "id": "cn-visa-ma-recent-no-modification",
      "check": "lighting",
      "expected": "recent_photo_no_modification",
      "evaluation": "manual",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["china-embassy-ma-visa-photo"],
      "sourceLiteral": "recent photo and unmodified"
    }
  ],
  "overlay": {
    "kind": "combined",
    "ruleIds": [
      "cn-visa-ma-face-width",
      "cn-visa-ma-head-top-margin",
      "cn-visa-ma-eye-line-from-bottom"
    ]
  },
  "capabilities": {
    "selfCapture": "not_confirmed",
    "crop": "allowed",
    "rotate": "allowed",
    "mirror": "forbidden",
    "retouch": "forbidden",
    "backgroundReplace": "forbidden",
    "requiresOriginalCameraFile": false,
    "requiresProfessionalPhotographer": false
  },
  "sourceNotes": {
    "en": [
      "reference_only: this revision is bound to the Rabat embassy (ma-rabat) and the 2025-04-27 source version; it can only be activated after verification against the actual portal.",
      "Must not be presented as a China-wide rule; head-width and other requirements differ between missions.",
      "Size-specific rules are constrained by the fixed 354×472 first revision.",
      "The 3:4 aspect is derived from the endpoints."
    ]
  }
}
