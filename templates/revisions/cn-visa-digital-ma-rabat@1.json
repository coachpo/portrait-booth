{
  "revisionId": "cn-visa-digital-ma-rabat@1",
  "id": "cn-visa-digital-ma-rabat",
  "version": 1,
  "schemaVersion": 1,
  "label": {
    "en": "China visa (Embassy in Morocco, digital 354x472)"
  },
  "jurisdiction": "CN",
  "documentType": "visa",
  "submissionChannel": "digital_upload",
