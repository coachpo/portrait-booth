{
  "revisionId": "jp-passport-paper@1",
  "id": "jp-passport-paper",
  "version": 1,
  "schemaVersion": 1,
  "label": {
    "en": "Japan passport (paper 35x45 mm)"
  },
  "jurisdiction": "JP",
  "documentType": "passport",
  "submissionChannel": "paper",
  "applicantClass": "adult",
  "sources": [
    {
      "id": "mofa-passport-photo",
      "url": "https://www.mofa.go.jp/mofaj/toko/passport/ic_photo.html",
      "title": "Passport photo specifications",
      "authority": "Ministry of Foreign Affairs (Japan)",
      "sourceUpdatedAt": "2026-01-01",
      "accessedAt": "2026-08-05"
    },
    {
      "id": "mofa-photo-spec-pdf",
      "url": "https://www.mofa.go.jp/mofaj/files/100171389.pdf",
      "title": "Passport photo specifications (PDF)",
      "authority": "Ministry of Foreign Affairs (Japan)",
      "accessedAt": "2026-08-05"
    }
  ],
  "output": {
    "kind": "physical_raster",
    "widthMm": 35,
    "heightMm": 45,
    "printPpi": 300,
    "rounding": "nearest",
    "widthPx": 413,
    "heightPx": 531,
    "pixelDerivation": "round(mm / 25.4 * printPpi)",
    "ppiProvenance": "derived",
    "calibrationProfileId": "pb-calib-paper-300ppi-v1"
  },
  "outputFile": {
    "mime": ["image/jpeg"],
    "colorSpace": "sRGB",
    "bitsPerChannel": 8,
    "channels": 3
  },
  "cropRules": [
    {
      "id": "jp-passport-paper-head-height",
      "metric": "head_height",
      "target": 34,
      "tolerance": 2,
      "min": 32,
      "max": 36,
      "unit": "mm",
      "anchors": ["top_of_head", "chin_tip"],
      "axis": "y",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "34 mm ± 2 mm (from top of head to tip of chin)"
    },
    {
      "id": "jp-passport-paper-head-top-margin",
      "metric": "head_top_margin",
      "target": 4,
      "tolerance": 2,
      "min": 2,
      "max": 6,
      "unit": "mm",
      "anchors": ["top_of_head"],
      "axis": "y",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "4 mm ± 2 mm from top of head to the upper edge of the photo"
    },
    {
      "id": "jp-passport-paper-chin-bottom-margin",
      "metric": "chin_bottom_margin",
      "target": 7,
      "tolerance": 2,
      "min": 5,
      "max": 9,
      "unit": "mm",
      "anchors": ["chin_tip"],
      "axis": "y",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "7 mm ± 2 mm from tip of chin to the lower edge of the photo"
    },
    {
      "id": "jp-passport-paper-face-center",
      "metric": "face_center_offset_x",
      "target": 17,
      "tolerance": 2,
      "min": 15,
      "max": 19,
      "unit": "mm",
      "anchors": ["face_center_line"],
      "axis": "x",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "face centre line: horizontal centre 17 mm ± 2 mm"
    },
    {
      "id": "jp-passport-paper-face-left-margin",
      "metric": "face_left_margin",
      "min": 2,
      "unit": "mm",
      "anchors": ["face_left"],
      "axis": "x",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "at least 2 mm from the face to each side edge"
    },
    {
      "id": "jp-passport-paper-face-right-margin",
      "metric": "face_right_margin",
      "min": 2,
      "unit": "mm",
      "anchors": ["face_right"],
      "axis": "x",
      "bounds": "inclusive",
      "coordinateSpace": "output_physical_mm_top_left",
      "evaluation": "automatic_with_manual_confirmation",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "at least 2 mm from the face to each side edge"
    }
  ],
  "captureRules": [
    {
      "id": "jp-passport-paper-background",
      "check": "background",
      "expected": "plain_no_pattern_no_shadow",
      "evaluation": "manual",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "plain background without patterns or shadows; white recommended"
    },
    {
      "id": "jp-passport-paper-recent-photo",
      "check": "lighting",
      "expected": "within_last_6_months",
      "evaluation": "manual",
      "enforcement": "mandatory",
      "provenance": "source_literal",
      "sourceRefs": ["mofa-passport-photo"],
      "sourceLiteral": "photographed within the last 6 months"
    }
  ],
  "overlay": {
    "kind": "combined",
    "ruleIds": [
      "jp-passport-paper-head-height",
      "jp-passport-paper-head-top-margin",
      "jp-passport-paper-chin-bottom-margin",
      "jp-passport-paper-face-center"
    ]
  },
  "capabilities": {
    "selfCapture": "allowed",
    "crop": "allowed",
    "rotate": "allowed",
    "mirror": "forbidden",
    "retouch": "forbidden",
    "backgroundReplace": "forbidden",
    "requiresOriginalCameraFile": false,
    "requiresProfessionalPhotographer": false
  },
  "sourceNotes": {
    "en": [
      "reference_only: the 300 ppi pixel encoding is derived; it can only be published as active after passing calibrated print tests.",
      "'horizontal centre 17 ± 2 mm' is recorded per the SPEC §5.2 table; content maintainers must confirm the measurement semantics against the Japanese MOFA source text (§14.3 source) when reviewing.",
      "Horizontal mirroring and retouching that alters one's appearance are prohibited."
    ]
  }
}
