{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portrait-booth.local/schema/template-publication-v1.schema.json",
  "title": "Template publication file (v1)",
  "description": "Structure of publications.json. A revision is immutable content; a publication is its mutable release state.",
  "type": "object",
  "required": ["schemaVersion", "publications"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "publications": {
      "description": "An empty array is itself valid: which revision is missing a record is reported by the load-time check, giving more precise errors.",
      "type": "array",
      "items": { "$ref": "#/$defs/publication" }
    }
  },
  "$defs": {
    "publication": {
      "type": "object",
      "required": [
        "revisionId",
        "status",
        "statusReason",
        "owner",
        "reviewer",
        "verifiedAt",
        "reviewDueAt",
        "effectiveAt",
        "publicationRevision"
      ],
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+@[0-9]+$"
        },
        "status": {
          "description": "active can be used to produce artifacts; all other states are never submittable.",
          "enum": ["active", "reference_only", "deprecated", "unsupported"]
        },
        "statusReason": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date" },
        "reviewDueAt": { "type": "string", "format": "date" },
        "effectiveAt": { "type": "string", "format": "date" },
        "validUntil": { "type": "string", "format": "date" },
        "publicationRevision": { "type": "integer", "minimum": 1 },
        "contentHash": {
          "description": "Content hash of the bound revision. When missing, a revision can be edited in place without bumping version and the system will not complain.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
