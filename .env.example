# Portrait Booth 后端环境变量（示例，不含真实值）
# 复制为 .env 并填写真实值；.env 已加入 .gitignore，不得提交。
#
# 本文件列出的变量名与代码实际读取的名字必须逐一对应，
# 由 backend/tests/test_config.py::TestEnvExample 强制校验。

# 【必填】HMAC 根密钥（base64url，解码后至少 32 字节）。
# 全部子密钥由它经 HKDF-SHA256 派生：KEY 指纹、删除密钥摘要、下载 token 摘要、
# 请求摘要、限速指纹、幂等 envelope 加密密钥。
# 缺失时进程拒绝启动——带随机密钥运行会让重启前发出的每个 KEY 与删除密钥同时失效，
# 而照片仍按 TTL 留存，用户既取不回也删不掉。
# 生成：python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PORTRAIT_SECRET_KEY_BASE=

# SQLite 数据库文件路径（默认 data/portrait.db）
PORTRAIT_DB_PATH=

# 照片对象存储目录（默认 data/objects；Docker 中挂载卷）
PORTRAIT_STORAGE_DIR=

# 前端构建产物目录（单容器部署时由后端托管；默认 ../frontend/dist）
PORTRAIT_FRONTEND_DIST=

# 暂存留存时长秒数（默认 2592000 = 30 天，见 SPEC §1.2.1；不提供静默续期）
PORTRAIT_TTL_SECONDS=

# 上传限制（默认与 SPEC §8.2 一致）
PORTRAIT_MAX_UPLOAD_BYTES=
PORTRAIT_MAX_PIXELS=
PORTRAIT_MAX_EDGE_PX=

# 限速阈值（默认与 SPEC §9.3 一致）
PORTRAIT_RESOLVE_FAIL_LIMIT=
PORTRAIT_RESOLVE_IP_LIMIT=
PORTRAIT_RESOLVE_IPV4_24_LIMIT=

# 生命周期 worker：清理间隔，以及 staging 对象被回收前的最小存活时间（§8.2）
PORTRAIT_PURGE_INTERVAL_SECONDS=
PORTRAIT_ORPHAN_MIN_AGE_SECONDS=

# 同源校验开关（默认开启；仅在无法提供 Origin 的本地调试场景下设为 0）
PORTRAIT_REQUIRE_SAME_ORIGIN=
