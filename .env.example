# Portrait Booth 后端环境变量（示例，不含真实值）
# 复制为 .env 并填写真实值；.env 已加入 .gitignore，不得提交。

# HMAC 域隔离密钥（base64url，至少 32 字节随机值）。
# 用途：KEY 指纹、删除密钥摘要、下载 token 摘要、请求摘要、限速指纹。
# 生成示例：python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY_BASE=

# SQLite 数据库文件路径（默认 backend/data/portrait-booth.db）
DB_PATH=

# 照片对象存储目录（默认 backend/data/photos；Docker 中挂载卷）
STORAGE_DIR=

# 暂存留存时长秒数（默认 2592000 = 30 天，见 SPEC §1.2.1；不提供静默续期）
TEMPORARY_STORAGE_TTL_SECONDS=

# 上传限制（默认与 SPEC §8.2 一致）
MAX_UPLOAD_BYTES=
MAX_IMAGE_MEGAPIXELS=
MAX_IMAGE_DIMENSION_PX=

# 限速阈值（默认与 SPEC §9.3 一致）
RATE_LIMIT_KEY_FAILURES_PER_15MIN=
RATE_LIMIT_IP_PER_HOUR=
RATE_LIMIT_IPV4_24_PER_HOUR=
