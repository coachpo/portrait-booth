# Portrait Booth backend environment variables (sample values only, no secrets)
# Copy to .env and fill in real values; .env is in .gitignore and must never be
# committed.
#
# Variable names listed here must match what the code actually reads, one by
# one; enforced by backend/tests/test_config.py::TestEnvExample.

# [REQUIRED] HMAC root secret key (base64url; at least 32 bytes after decoding).
# All subkeys are derived from it via HKDF-SHA256: KEY fingerprint, delete
# secret digest, download token digest, request digest, rate-limit
# fingerprint, and the idempotency envelope encryption key.
# The process refuses to start without it - running with a random key would
# invalidate every previously issued KEY and delete secret on restart while
# photos stay for the TTL, leaving users unable to retrieve or delete them.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PORTRAIT_SECRET_KEY_BASE=

# SQLite database file path (default data/portrait.db)
PORTRAIT_DB_PATH=

# Photo object storage directory (default data/objects; mounted volume in Docker)
PORTRAIT_STORAGE_DIR=

# Frontend build output directory (hosted by the backend in single-container
# deployments; default ../frontend/dist)
PORTRAIT_FRONTEND_DIST=

# Template catalog directory, holding schema/, revisions/ and
# publications.json. The default is derived from the source layout
# (repository root + /templates). Any deployment whose directory layout
# differs from the repository - the Docker image among them - must set this,
# or every template request fails with a 500 while the healthcheck still
# reports healthy.
PORTRAIT_TEMPLATES_DIR=

# Staging retention duration in seconds (default 2592000 = 30 days, see SPEC
# §1.2.1; no silent renewal)
PORTRAIT_TTL_SECONDS=

# Upload limits (defaults match SPEC §8.2)
PORTRAIT_MAX_UPLOAD_BYTES=
PORTRAIT_MAX_PIXELS=
PORTRAIT_MAX_EDGE_PX=

# Rate limit thresholds (defaults match SPEC §9.3)
PORTRAIT_RESOLVE_FAIL_LIMIT=
PORTRAIT_RESOLVE_IP_LIMIT=
PORTRAIT_RESOLVE_IPV4_24_LIMIT=

# Lifecycle worker: cleanup interval, and minimum age before a staging object
# can be reclaimed (§8.2)
PORTRAIT_PURGE_INTERVAL_SECONDS=
PORTRAIT_ORPHAN_MIN_AGE_SECONDS=
# Idempotency record retention window (default 600s; after the window expires
# records are deleted at most one cleanup interval later)
PORTRAIT_IDEMPOTENCY_WINDOW_SECONDS=

# Same-origin enforcement switch (on by default; set to 0 only for local
# debugging scenarios that cannot provide an Origin)
PORTRAIT_REQUIRE_SAME_ORIGIN=
